<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - WUZZSTORE</title>
    
    <link rel="stylesheet" href="/css/tailwind.css">
</head>
<body class="bg-slate-900 text-white overflow-hidden flex justify-center items-center min-h-screen font-sans" style="background: radial-gradient(ellipse at center, #1e293b 0%, #0f172a 100%);">
    <div class="stars-bg">
        <div class="stars"></div>
        <div class="stars"></div>
        <div class="stars"></div>
    </div>

    <div class="bg-slate-800/70 backdrop-blur-xl p-10 rounded-3xl shadow-2xl border border-white/10 w-full max-w-sm text-center hover:-translate-y-1 transition">
        <h1 class="text-4xl font-extrabold tracking-tight bg-gradient-to-br from-white to-indigo-300 bg-clip-text text-transparent mb-4">WUZZSTORE</h1>
        <h3 class="text-lg font-semibold mb-5">Atur Ulang Password Anda</h3>

        <div id="message-display" class="text-center font-bold mb-4"></div>

        <form id="resetPasswordForm">
            <input type="hidden" id="token" name="token" value="<%= token %>">
            
            <div class="mb-5">
                <label for="newPassword" class="text-slate-300 text-sm font-semibold text-left block mb-2">Password Baru</label>
                <input type="password" id="newPassword" name="newPassword" class="w-full px-4 py-3 bg-slate-900/60 border border-white/10 rounded-xl text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/25 outline-none" placeholder="Masukkan password baru" required>
            </div>
            
            <div class="mb-5">
                <label for="confirmPassword" class="text-slate-300 text-sm font-semibold text-left block mb-2">Konfirmasi Password Baru</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="w-full px-4 py-3 bg-slate-900/60 border border-white/10 rounded-xl text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/25 outline-none" placeholder="Ulangi password baru" required>
            </div>
            
            <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold shadow-lg shadow-indigo-500/30 hover:-translate-y-0.5 hover:shadow-indigo-500/40 transition">Reset Password</button>
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const resetPasswordForm = document.getElementById('resetPasswordForm');
            const messageDisplay = document.getElementById('message-display');
            const submitButton = resetPasswordForm.querySelector('button');

            resetPasswordForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const token = document.getElementById('token').value;
                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;

                // Validasi kecocokan password di sisi klien
                if (newPassword !== confirmPassword) {
                    messageDisplay.style.color = '#d9534f';
                    messageDisplay.textContent = 'Password dan konfirmasi password tidak cocok.';
                    return;
                }

                // Ubah status tombol saat loading
                submitButton.disabled = true;
                submitButton.textContent = 'Memproses...';
                messageDisplay.textContent = '';
                messageDisplay.style.color = '';

                try {
                    // Kirim data ke API Backend
                    const response = await fetch('/api/auth/reset-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ token, newPassword })
                    });
                    const result = await response.json();

                    if (!response.ok) {
                        throw new Error(result.message || 'Terjadi kesalahan.');
                    }

                    // Sukses
                    messageDisplay.style.color = '#5cb85c';
                    messageDisplay.textContent = result.message;
                    submitButton.style.display = 'none';

                    // Redirect otomatis ke halaman login setelah 3 detik
                    setTimeout(() => {
                        window.location.href = '/login';
                    }, 3000);

                } catch (error) {
                    // Gagal
                    messageDisplay.style.color = '#d9534f';
                    messageDisplay.textContent = 'Error: ' + error.message;
                    submitButton.disabled = false;
                    submitButton.textContent = 'Reset Password';
                }
            });
        });
    </script>
</body>
</html>
