<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - WUZZSTORE</title>
    
    <link rel="stylesheet" href="/css/tailwind.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>
<body class="bg-gray-100 dark:bg-slate-900 text-gray-800 dark:text-gray-100 min-h-screen flex flex-col overflow-x-hidden font-sans transition-colors duration-300">

    <%- include('partials/sidebar', { user: user }) %>
    <%- include('partials/header', { user: user }) %>

    <main class="p-6 w-full max-w-7xl mx-auto transition-all lg:ml-[260px] lg:w-[calc(100%-260px)] lg:p-10">
        <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 mb-6 border border-gray-200 dark:border-slate-700 shadow-sm dark:shadow-none">
            
            <h2 class="mb-5 text-gray-800 dark:text-gray-100 font-bold tracking-tight text-xl"><i class="fas fa-user-cog"></i> Pengaturan Profil</h2>
            <form id="profileForm">
                <div class="mb-5 text-left">
                    <label for="username" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Username</label>
                    <input type="text" id="username" name="username" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition">
                </div>
                <div class="mb-5 text-left">
                    <label for="phone" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Nomor HP</label>
                    <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition">
                </div>
                <div class="mb-5 text-left">
                    <label for="email" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Email</label>
                    <input type="email" id="email" name="email" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition">
                </div>
                <div class="mb-5 text-left">
                    <label for="telegram" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">ID Telegram</label>
                    <input type="number" id="telegram" name="telegram" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" placeholder="Contoh: 123456789">
                </div>

                <div class="mb-5 text-left">
                    <label for="apikey" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">API Key</label>
                    <div class="flex items-center gap-2.5">
                        <input type="text" id="apikey" name="apikey" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" readonly>
                        <button type="button" id="regenerateApiKey" class="bg-indigo-500/10 border-none w-11 h-11 rounded-xl text-indigo-500 cursor-pointer flex items-center justify-center text-xl hover:bg-indigo-500/20 transition" title="Ganti API Key"><i class="fas fa-sync-alt"></i></button>
                    </div>
                </div>
                
                <div class="mb-5 text-left">
                    <label for="webhook" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">URL Webhook (Notifikasi Transaksi)</label>
                    <div class="flex items-center gap-2.5">
                        <input type="url" id="webhook" name="webhook" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" placeholder="https://domain-anda.com/webhook">
                        <button type="button" id="saveWebhookBtn" class="bg-indigo-500/10 border-none w-11 h-11 rounded-xl text-indigo-500 cursor-pointer flex items-center justify-center text-xl hover:bg-indigo-500/20 transition" title="Simpan Webhook"><i class="fas fa-save"></i></button>
                    </div>
                </div>

                <div class="flex flex-col gap-4 mt-6">
                    <button type="submit" class="w-full py-3.5 rounded-xl bg-emerald-500 text-white font-semibold shadow-lg shadow-emerald-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer">
                        <i class="fas fa-save"></i> Simpan Perubahan Profile
                    </button>
                    
                    <a href="/docs" class="w-full py-3.5 rounded-xl bg-blue-500 text-white font-semibold shadow-lg shadow-blue-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer no-underline text-center block">
                        <i class="fas fa-book"></i> Dokumentasi API
                    </a>
                </div>
            </form>

            <hr class="border-0 border-t border-gray-200 dark:border-slate-700 my-8">

            <h2 class="mb-5 text-gray-800 dark:text-gray-100 font-bold tracking-tight text-xl"><i class="fas fa-lock"></i> Ubah Password</h2>
            <form id="passwordForm">
                <div class="mb-5 text-left">
                    <label for="oldPassword" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Password Sebelumnya</label>
                    <input type="password" id="oldPassword" name="oldPassword" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" required>
                </div>
                <div class="mb-5 text-left">
                    <label for="newPassword" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Password Baru</label>
                    <input type="password" id="newPassword" name="newPassword" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" required>
                </div>
                <button type="submit" class="w-full py-3.5 rounded-xl bg-red-500 text-white font-semibold shadow-lg shadow-red-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer mt-2.5">
                    <i class="fas fa-key"></i> Ubah Password
                </button>
            </form>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const profileForm = document.getElementById('profileForm');
            const passwordForm = document.getElementById('passwordForm');
            const regenerateBtn = document.getElementById('regenerateApiKey');
            const saveWebhookBtn = document.getElementById('saveWebhookBtn');

            document.getElementById('username').value = "<%= user.username %>";
            document.getElementById('phone').value = "<%= user.phone || '' %>";
            document.getElementById('email').value = "<%= user.email %>";
            document.getElementById('telegram').value = "<%= user.telegram || '' %>";
            document.getElementById('apikey').value = "<%= user.apikey %>";
            document.getElementById('webhook').value = "<%= user.webhook || '' %>";

            profileForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(profileForm);
                formData.delete('webhook');
                formData.delete('apikey');
                const data = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch('/api/profile/update', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();
                    if (!response.ok) throw new Error(result.message);
                    alert(result.message);
                } catch (error) {
                    alert('Gagal update profil: ' + error.message);
                }
            });

            passwordForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(passwordForm);
                const data = Object.fromEntries(formData.entries());
                try {
                    const response = await fetch('/api/password/update', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();
                    if (!response.ok) throw new Error(result.message);
                    alert(result.message);
                    passwordForm.reset();
                } catch (error) {
                    alert('Gagal update password: ' + error.message);
                }
            });

            regenerateBtn.addEventListener('click', () => {
                if (confirm('Yakin ingin ganti API Key? Key lama akan mati.')) {
                    fetch('/api/apikey/regenerate', { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.newApiKey) {
                            document.getElementById('apikey').value = data.newApiKey;
                            alert('API Key diperbarui!');
                        } else {
                            alert('Gagal.');
                        }
                    });
                }
            });
            
            saveWebhookBtn.addEventListener('click', async () => {
                const webhookUrl = document.getElementById('webhook').value;
                if (webhookUrl && !webhookUrl.startsWith('http')) {
                    alert('URL harus diawali http:// atau https://');
                    return;
                }
                try {
                    const response = await fetch('/api/profile/update-webhook', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ webhook: webhookUrl })
                    });
                    const result = await response.json();
                    if (!response.ok) throw new Error(result.message);
                    alert(result.message);
                } catch (error) {
                    alert('Gagal: ' + error.message);
                }
            });
        });
    </script>
    
    <script src="/js/sidebar.js"></script>
    <script src="/js/theme.js"></script>
    <script src="/js/submenu.js"></script>
</body>
</html>
