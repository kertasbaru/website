<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XL Akrab V2 - WUZZSTORE</title>
    
    <link rel="stylesheet" href="/css/tailwind.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>
<body class="bg-gray-100 dark:bg-slate-900 text-gray-800 dark:text-gray-100 min-h-screen flex flex-col overflow-x-hidden font-sans transition-colors duration-300">

    <%- include('partials/sidebar', { user: user }) %>
    <%- include('partials/header', { user: user }) %>

    <main class="p-6 w-full max-w-7xl mx-auto transition-all lg:ml-[260px] lg:w-[calc(100%-260px)] lg:p-10">
        <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 mb-6 border border-gray-200 dark:border-slate-700 shadow-sm dark:shadow-none relative overflow-hidden">
            <h2 class="mb-5 text-gray-800 dark:text-gray-100 font-bold tracking-tight text-xl"><i class="fas fa-users"></i> XL Akrab V2</h2>
            <p class="text-gray-500 dark:text-slate-400 text-sm mb-4">Masukkan nomor XL Anda untuk melihat daftar paket Akrab.</p>
            
            <div id="message-display" class="tembak-info-box" style="display: none; margin-bottom: 15px;"></div>
            
            <form id="checkAkrabForm" onsubmit="return false;">
                <div class="mb-5 text-left">
                    <label for="nomorInput" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Nomor XL</label>
                    <input type="tel" id="nomorInput" name="number" placeholder="Contoh: 0878..." class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" autocomplete="off" required>
                </div>
            </form>
        </div>

        <div id="products-container" class="bg-white dark:bg-slate-800 rounded-2xl p-6 mb-6 border border-gray-200 dark:border-slate-700 shadow-sm dark:shadow-none relative overflow-hidden" style="display: none; margin-top: 20px;">
            <h3 class="mb-5 text-gray-800 dark:text-gray-100 font-bold tracking-tight text-lg"><i class="fas fa-box-open"></i> Daftar Produk</h3>
            <div class="flex gap-2 flex-wrap mt-4 border-b border-gray-200 dark:border-slate-700 pb-2">
                <button class="tab-button active px-4 py-2 rounded-lg text-sm font-semibold cursor-pointer border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-600 dark:text-slate-400 hover:border-indigo-500 hover:text-indigo-500 transition" data-tab="akb">Fresh</button>
                <button class="tab-button px-4 py-2 rounded-lg text-sm font-semibold cursor-pointer border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-600 dark:text-slate-400 hover:border-indigo-500 hover:text-indigo-500 transition" data-tab="bpa">Bekasan</button>
                <button class="tab-button px-4 py-2 rounded-lg text-sm font-semibold cursor-pointer border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-600 dark:text-slate-400 hover:border-indigo-500 hover:text-indigo-500 transition" data-tab="crl">Circle</button>
                <button class="tab-button px-4 py-2 rounded-lg text-sm font-semibold cursor-pointer border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-600 dark:text-slate-400 hover:border-indigo-500 hover:text-indigo-500 transition" data-tab="pdfm">Flex</button>
            </div>
            <div id="tab-content">
                <div id="akb-products" class="tab-pane active"></div>
                <div id="bpa-products" class="tab-pane"></div>
                <div id="crl-products" class="tab-pane"></div>
                <div id="pdfm-products" class="tab-pane"></div>
            </div>
        </div>
    </main>

    <div id="productDetailModal" class="modal" style="display: none;">
        <div class="modal-content bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-100 mx-auto my-[5%] p-8 w-[90%] max-w-md rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 relative animate-slideDown">
            <span class="modal-close-btn absolute top-5 right-5 text-gray-400 dark:text-slate-500 text-2xl cursor-pointer hover:text-red-500 transition">&times;</span>
            
            <div id="buyView">
                <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">KONFIRMASI PEMBELIAN</h3>
                <hr style="margin-bottom: 20px; border-color: var(--border-color-light);">
                <form id="buyForm" data-code="">
                    <div class="mb-5 text-left">
                        <label class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Nama Produk</label>
                        <input id="modalNamaProduk" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" type="text" readonly disabled>
                    </div>
                    <div class="mb-5 text-left">
                        <label class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Nomor Tujuan</label>
                        <input id="modalNomor" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" type="text" readonly disabled>
                    </div>
                    <div class="mb-5 text-left">
                        <label class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Harga</label>
                        <input id="modalHarga" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" type="text" readonly disabled style="color: var(--primary-color); font-weight: 700;">
                    </div>
                    <div class="mb-5 text-left">
                        <label class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Deskripsi & Zona</label>
                        <div id="modalDescription" class="bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl p-4 text-sm text-gray-600 dark:text-slate-300 max-h-40 overflow-y-auto"></div>
                    </div>
                    <div class="flex gap-4 mt-6">
                        <button type="button" class="btn closeModalBtn w-full py-3.5 rounded-xl bg-red-500 text-white font-semibold shadow-lg shadow-red-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer">Batal</button>
                        <button type="submit" id="buyButton" class="btn w-full py-3.5 rounded-xl bg-emerald-500 text-white font-semibold shadow-lg shadow-emerald-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer">Beli Sekarang</button>
                    </div>
                </form>
            </div>

            <div id="detailView" style="display: none;">
                <div class="relative">
                    <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">DETAIL TRANSAKSI</h3>
                    <div class="loading-line"></div>
                </div>
                <hr style="margin-bottom: 20px; border-color: var(--border-color-light);">
                <form id="detailForm">
                    <div class="mb-5 text-left"><label class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Ref ID</label><input id="detailRefId" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" readonly disabled></div>
                    <div class="mb-5 text-left"><label class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Nomor</label><input id="detailNomor" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" readonly disabled></div>
                    <div class="mb-5 text-left"><label class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Produk</label><input id="detailNamaProduk" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" readonly disabled></div>
                    <div class="mb-5 text-left"><label class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Harga</label><input id="detailHarga" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" readonly disabled></div>
                    <div class="mb-5 text-left"><label class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Status</label><input id="detailStatus" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" readonly disabled style="font-weight: bold;"></div>
                    <div class="mb-5 text-left"><label class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Pesan Provider</label><textarea id="detailMessage" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" readonly disabled rows="2"></textarea></div>
                    <button type="button" class="btn closeModalBtn w-full py-3.5 rounded-xl bg-gray-500 text-white font-semibold shadow-lg shadow-gray-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer" style="margin-top: 15px;">Tutup</button>
                </form>
            </div>
        </div>
    </div>

    <div id="txErrorModal" class="modal" style="display: none;">
        <div class="modal-content bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-100 mx-auto my-[5%] p-8 w-[90%] max-w-md rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 relative animate-slideDown">
            <div class="modal-icon" style="color: #d9534f; font-size: 4rem; margin-bottom: 15px;"><i class="fas fa-times-circle"></i></div>
            <h4 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">Transaksi Gagal</h4>
            <p id="txErrorMessage" style="color: #555;">Terjadi kesalahan.</p>
            <button type="button" id="closeTxErrorModalBtn" class="btn w-full py-3.5 rounded-xl bg-red-500 text-white font-semibold shadow-lg shadow-red-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer" style="max-width: 200px; margin: 20px auto 0;">OK</button>
        </div>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const nomorInput = document.getElementById('nomorInput');
            const messageDisplay = document.getElementById('message-display');
            const productsContainer = document.getElementById('products-container');
            const akbContainer = document.getElementById('akb-products');
            const bpaContainer = document.getElementById('bpa-products');
            const crlContainer = document.getElementById('crl-products');
            const pdfmContainer = document.getElementById('pdfm-products');
            const tabButtons = document.querySelectorAll('.tab-button');
            
            const detailModal = document.getElementById('productDetailModal');
            const closeModalBtns = document.querySelectorAll('.modal-close-btn, .closeModalBtn');
            const buyView = document.getElementById('buyView');
            const detailView = document.getElementById('detailView');
            const buyForm = document.getElementById('buyForm');
            const buyButton = document.getElementById('buyButton');
            const txErrorModal = document.getElementById('txErrorModal');
            const txErrorMessage = document.getElementById('txErrorMessage');
            const closeTxErrorModalBtn = document.getElementById('closeTxErrorModalBtn');

            let debounceTimer;
            let allProducts = [];
            let productsFetched = false;
            let pollingInterval = null;

            const showMessage = (text, type = 'info') => {
                messageDisplay.textContent = text;
                messageDisplay.className = `tembak-info-box ${type}`;
                messageDisplay.style.display = text ? 'block' : 'none';
            };

            const formatCurrency = (amount) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(amount);

            const updateBalance = () => {
                const userBalanceElement = document.getElementById('user-balance');
                if (userBalanceElement) {
                    fetch('/api/user').then(res => res.json()).then(data => {
                        if (data && data.balance != null) userBalanceElement.textContent = formatCurrency(data.balance);
                    });
                }
            };
            
            const cekNomorXl = (nomor) => {
                const cleaned = String(nomor).replace(/[\s+-]/g, '');
                if (!cleaned.startsWith('08')) return false;
                const prefixXl = ['817', '818', '819', '859', '877', '878', '838', '831', '832', '833'];
                return prefixXl.includes(cleaned.substring(1, 4));
            };

            const renderProductList = (products, targetContainer) => {
                targetContainer.innerHTML = '';
                if (!products || products.length === 0) {
                    targetContainer.innerHTML = `<p style="text-align: center; color: var(--text-muted-light);">Tidak ada produk di kategori ini.</p>`;
                    return;
                }
                targetContainer.innerHTML = products.map(product => `
                    <div class="product-item" data-code="${product.code}" style="cursor: pointer;">
                        <table>
                            <tr>
                                <td class="product-name">
                                    ${product.name}
                                    <div style="font-size: 0.8rem; color: var(--text-muted-light); margin-top: 5px;">
                                        Stok: <strong style="color: ${product.stock > 0 ? '#10b981' : '#ef4444'};">${product.stock}</strong>
                                    </div>
                                </td>
                                <td class="product-fee-info">
                                    <span class="product-fee-label">Harga</span>
                                    <div class="product-fee-value">${formatCurrency(product.final_price)}</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                `).join('');
            };

            const displayProducts = (products) => {
                if (!Array.isArray(products)) return;
                allProducts = products;
                const akbProducts = allProducts.filter(p => p.code.includes('KDA') || p.code.includes('PDA'));
                const bpaProducts = allProducts.filter(p => p.code.includes('PBPA') || p.code.includes('KBPA'));
                const crlProducts = allProducts.filter(p => p.code.includes('PCRL'));
                const pdfmProducts = allProducts.filter(p => p.code.includes('KDF') || p.code.includes('PDF'));
                renderProductList(akbProducts, akbContainer);
                renderProductList(bpaProducts, bpaContainer);
                renderProductList(crlProducts, crlContainer);
                renderProductList(pdfmProducts, pdfmContainer);
            };

            const fetchProducts = async () => {
                if (productsFetched) return;
                showMessage('Mengambil daftar produk...', 'info');
                productsContainer.style.display = 'block';
                try {
                    const response = await fetch('/api/xl/list-product', { method: 'POST' });
                    const result = await response.json();
                    if (!response.ok || !result.success) throw new Error(result.message);
                    productsFetched = true;
                    showMessage('', 'info');
                    displayProducts(result.data.products);
                } catch (error) {
                    showMessage(error.message, 'error');
                    productsContainer.style.display = 'none';
                }
            };

            nomorInput.addEventListener('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '');
                if (this.value.startsWith('62')) this.value = '0' + this.value.substring(2);
                clearTimeout(debounceTimer);
                const value = this.value;
                if (value.length >= 4) {
                    if (cekNomorXl(value)) {
                        showMessage('Nomor Valid. Memuat...', 'info');
                        debounceTimer = setTimeout(fetchProducts, 300);
                    } else { showMessage('Bukan nomor XL.', 'error'); productsContainer.style.display = 'none'; }
                } else { showMessage('', 'info'); productsContainer.style.display = 'none'; }
            });

            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('active'));
                    button.classList.add('active');
                    document.getElementById(button.getAttribute('data-tab') + '-products').classList.add('active');
                });
            });

            const startPolling = (ref_id) => {
                if (pollingInterval) clearInterval(pollingInterval);
                pollingInterval = setInterval(async () => {
                    try {
                        const res = await fetch(`/api/transaction/status/${ref_id}`);
                        if (!res.ok) { clearInterval(pollingInterval); return; }
                        const data = await res.json();
                        const statusInput = document.getElementById('detailStatus');
                        const messageInput = document.getElementById('detailMessage');
                        const loadingLine = document.querySelector('#detailView .loading-line');
                        if (messageInput && data.message) messageInput.value = data.message;
                        if (statusInput && statusInput.value.toLowerCase() !== data.status.toLowerCase()) {
                            statusInput.value = data.status.toUpperCase();
                            if (['success', 'sukses', 'failed', 'gagal'].includes(data.status.toLowerCase())) {
                                clearInterval(pollingInterval);
                                if (loadingLine) loadingLine.style.display = 'none';
                                if(['failed', 'gagal'].includes(data.status.toLowerCase())) updateBalance();
                            }
                        }
                    } catch (error) { clearInterval(pollingInterval); }
                }, 5000);
            };

            productsContainer.addEventListener('click', (e) => {
                const item = e.target.closest('.product-item');
                if (!item) return;
                const product = allProducts.find(p => p.code === item.dataset.code);
                if (product) {
                    buyForm.dataset.code = product.code;
                    document.getElementById('modalNomor').value = nomorInput.value;
                    document.getElementById('modalNamaProduk').value = product.name;
                    document.getElementById('modalHarga').value = formatCurrency(product.final_price);
                    let descHtml = '';
                    if (Array.isArray(product.description)) descHtml = `<ul>${product.description.map(d => `<li>${d}</li>`).join('')}</ul>`;
                    else if (typeof product.description === 'string') descHtml = product.description.replace(/\n/g, '<br>');
                    document.getElementById('modalDescription').innerHTML = descHtml;
                    buyView.style.display = 'block'; detailView.style.display = 'none';
                    detailModal.style.display = 'block';
                }
            });

            buyForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const code = buyForm.dataset.code;
                const destination = document.getElementById('modalNomor').value;
                buyButton.disabled = true; buyButton.textContent = 'Memproses...';
                try {
                    const response = await fetch('/api/xl/akrabv2/order', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ code, destination })
                    });
                    const result = await response.json();
                    if (!response.ok || !result.success) throw new Error(result.message);
                    
                    document.getElementById('detailRefId').value = result.data.ref_id || '-';
                    document.getElementById('detailNomor').value = result.data.destination;
                    document.getElementById('detailNamaProduk').value = document.getElementById('modalNamaProduk').value;
                    document.getElementById('detailStatus').value = result.data.status.toUpperCase();
                    document.getElementById('detailMessage').value = result.data.message;
                    document.getElementById('detailHarga').value = document.getElementById('modalHarga').value;

                    buyView.style.display = 'none'; detailView.style.display = 'block';
                    updateBalance();
                    
                    if (result.data.ref_id && !['success', 'failed'].includes(result.data.status)) {
                        document.querySelector('#detailView .loading-line').style.display = 'block';
                        startPolling(result.data.ref_id);
                    } else document.querySelector('#detailView .loading-line').style.display = 'none';
                } catch (error) { detailModal.style.display = 'none'; showTxErrorModal(error.message); } 
                finally { buyButton.disabled = false; buyButton.textContent = 'Beli'; }
            });

            const hideModal = () => { if (pollingInterval) clearInterval(pollingInterval); detailModal.style.display = 'none'; txErrorModal.style.display = 'none'; };
            const showTxErrorModal = (msg) => { txErrorMessage.textContent = msg; txErrorModal.style.display = 'block'; };
            closeModalBtns.forEach(btn => btn.addEventListener('click', hideModal));
            closeTxErrorModalBtn.addEventListener('click', hideModal);
            window.addEventListener('click', (e) => { if ([detailModal, txErrorModal].includes(e.target)) hideModal(); });
        });
    </script>
    <script src="/js/sidebar.js"></script>
    <script src="/js/theme.js"></script>
    <script src="/js/submenu.js"></script>
</body>
</html>
