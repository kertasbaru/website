<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Top Up Saldo - WUZZSTORE</title>
    
    <link rel="stylesheet" href="/css/tailwind.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/qrcode-generator/qrcode.js"></script>
</head>
<body class="bg-gray-100 dark:bg-slate-900 text-gray-800 dark:text-gray-100 min-h-screen flex flex-col overflow-x-hidden font-sans transition-colors duration-300">

    <%- include('partials/sidebar', { user: user }) %>
    <%- include('partials/header', { user: user }) %>

    <main class="p-6 w-full max-w-7xl mx-auto transition-all lg:ml-[260px] lg:w-[calc(100%-260px)] lg:p-10">
        <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 mb-6 border border-gray-200 dark:border-slate-700 shadow-sm dark:shadow-none">
            <h2 class="mb-5 text-gray-800 dark:text-gray-100 font-bold tracking-tight text-xl"><i class="fas fa-wallet"></i> Top Up Saldo</h2>
            <p class="-mt-2.5 mb-6 text-sm text-gray-500 dark:text-slate-400 leading-relaxed">Masukkan nominal saldo yang ingin Anda isi.</p>
            
            <form id="topUpForm">
                <div class="mb-5 text-left">
                    <label for="amount" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Nominal Top Up</label>
                    <input type="number" id="amount" name="amount" placeholder="Contoh: 50000" min="10000" max="950000" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" required>
                </div>
                <button type="submit" class="w-full py-3.5 rounded-xl bg-emerald-500 text-white font-semibold shadow-lg shadow-emerald-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer mt-5">
                    <i class="fas fa-qrcode"></i> Buat Pembayaran QRIS
                </button>
            </form>
        </div>

        <div class="border border-gray-200 dark:border-slate-700 rounded-2xl bg-white dark:bg-slate-800 mt-5 overflow-hidden transition-all">
            <div class="p-5 font-semibold flex justify-between items-center gap-2.5 text-gray-800 dark:text-gray-100">
                <span><i class="fas fa-hourglass-half"></i> Menunggu Pembayaran</span>
            </div>
            <div class="block px-5 pb-5 border-t border-gray-200 dark:border-slate-700">
                <div class="w-full overflow-x-auto border border-gray-200 dark:border-slate-700 rounded-xl mt-4">
                    <table class="w-full border-collapse text-[0.95rem]">
                        <thead>
                            <tr>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">ID</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Jumlah</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Status</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="pending-deposits-table-body">
                            <tr><td colspan="4" class="p-4 border-b border-gray-200 dark:border-slate-700 text-gray-800 dark:text-gray-100 text-center">Memuat data...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <div id="qrisModal" class="hidden fixed inset-0 z-[3000] overflow-auto bg-black/50 backdrop-blur-sm pt-[60px]">
        <div class="bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-100 mx-auto p-8 w-[90%] max-w-[400px] rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 relative animate-slideDown mt-[5%]">
            <div class="text-center mb-4">
                <h3 class="m-0 font-bold text-xl text-gray-800 dark:text-gray-100">Scan QRIS</h3>
                <p class="text-sm text-gray-500 dark:text-slate-400">Scan menggunakan E-Wallet / M-Banking</p>
            </div>

            <div class="flex justify-center mb-5">
                <div id="qrcode-container" class="p-4 bg-white rounded-xl border border-gray-200"></div>
            </div>
            
            <ul class="list-none p-0 m-0 mb-5">
                <li class="flex justify-between items-center py-3 border-b border-dashed border-gray-200 dark:border-slate-700 text-[0.95rem]">
                    <dt class="text-gray-500 dark:text-slate-400 font-medium">Bank Jago</dt>
                    <dd class="font-semibold text-gray-800 dark:text-gray-100 text-right">105327562286 (Abdul Wahab Sahroni)</dd>
                </li>
                <li class="flex justify-between items-center py-3 border-b border-dashed border-gray-200 dark:border-slate-700 text-[0.95rem]">
                    <dt class="text-gray-500 dark:text-slate-400 font-medium">ID Transaksi</dt>
                    <dd id="modalTopUpId" class="font-semibold text-gray-800 dark:text-gray-100 text-right font-mono"></dd>
                </li>
                <li class="flex justify-between items-center py-3 border-b-0 text-[0.95rem]">
                    <dt class="text-gray-500 dark:text-slate-400 font-medium">Total Bayar</dt>
                    <dd id="modalFinalAmount" class="font-semibold text-indigo-500 text-right text-lg"></dd>
                </li>
            </ul>
            
            <div class="bg-blue-50 dark:bg-blue-500/15 border border-blue-200 dark:border-blue-500/30 rounded-xl p-2.5 text-blue-800 dark:text-blue-300 text-sm text-center mb-5">
                <i class="fas fa-sync fa-spin"></i> Menunggu pembayaran otomatis...
            </div>
            
            <div class="flex gap-4 mt-6">
                <button type="button" id="cancelPaymentBtn" class="w-full py-3.5 rounded-xl bg-red-500 text-white font-semibold shadow-lg shadow-red-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer">Batalkan</button>
                <button type="button" id="closeModalBtn" class="w-full py-3.5 rounded-xl bg-gray-400 text-white font-semibold shadow-lg hover:-translate-y-0.5 transition border-none cursor-pointer">Tutup</button>
            </div>
        </div>
    </div>

    <div id="verificationModal" class="hidden fixed inset-0 z-[3000] overflow-auto bg-black/50 backdrop-blur-sm pt-[60px]">
        <div class="bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-100 mx-auto p-8 w-[90%] max-w-[350px] rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 relative animate-slideDown mt-[5%] text-center">
            <div class="text-5xl text-amber-500 mb-4"><i class="fas fa-exclamation-triangle"></i></div>
            <h4 class="font-bold text-lg text-gray-800 dark:text-gray-100">Batalkan Deposit?</h4>
            <p class="mb-6 text-gray-500 dark:text-slate-400">Transaksi akan dihapus dan tidak bisa dipulihkan.</p>
            <div class="flex gap-4 mt-6">
                <button type="button" id="declineCancelBtn" class="w-full py-3.5 rounded-xl bg-gray-400 text-white font-semibold shadow-lg hover:-translate-y-0.5 transition border-none cursor-pointer">Kembali</button>
                <button type="button" id="confirmCancelBtn" class="w-full py-3.5 rounded-xl bg-red-500 text-white font-semibold shadow-lg shadow-red-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer">Ya, Batalkan</button>
            </div>
        </div>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const topUpForm = document.getElementById('topUpForm');
            const qrisModal = document.getElementById('qrisModal');
            const closeModalBtn = document.getElementById('closeModalBtn');
            const cancelPaymentBtn = document.getElementById('cancelPaymentBtn');
            const tableBody = document.getElementById('pending-deposits-table-body');
            
            const verificationModal = document.getElementById('verificationModal');
            const confirmCancelBtn = document.getElementById('confirmCancelBtn');
            const declineCancelBtn = document.getElementById('declineCancelBtn');

            let pollingInterval = null;

            const formatCurrency = (amount) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(amount);

            // Render Tabel
            const addDepositToTable = (deposit) => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-gray-800 dark:text-gray-100 align-middle"><small class="font-mono">${deposit.top_up_id}</small></td>
                    <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-indigo-500 font-bold align-middle">${formatCurrency(deposit.amount)}</td>
                    <td class="p-4 border-b border-gray-200 dark:border-slate-700 align-middle text-center"><span class="px-3 py-1.5 rounded-full font-bold text-xs uppercase tracking-wide bg-amber-100 text-amber-600">${deposit.status}</span></td>
                    <td class="p-4 border-b border-gray-200 dark:border-slate-700 align-middle text-center"><button class="btn-view inline-flex items-center justify-center w-8 h-8 p-0 rounded-full bg-blue-500 text-white shadow-none border-none cursor-pointer" data-id="${deposit.top_up_id}"><i class="fas fa-eye"></i></button></td>
                `;
                return row;
            };

            // Fetch Data Pending
            const fetchPendingDeposits = async () => {
                try {
                    const response = await fetch('/api/deposits/pending');
                    const deposits = await response.json();
                    tableBody.innerHTML = '';
                    if (deposits.length > 0) {
                        deposits.forEach(deposit => tableBody.appendChild(addDepositToTable(deposit)));
                    } else {
                        tableBody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-gray-500 dark:text-slate-400">Tidak ada tagihan pending.</td></tr>';
                    }
                } catch (error) {
                    tableBody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-red-500">Gagal memuat data.</td></tr>';
                }
            };

            // Polling Status
            const startPolling = (topUpId) => {
                if (pollingInterval) clearInterval(pollingInterval);
                pollingInterval = setInterval(async () => {
                    try {
                        const response = await fetch(`/api/deposit/status/${topUpId}`);
                        if (!response.ok) return;
                        const data = await response.json();
                        if (['SUCCESS', 'success'].includes(data.status)) {
                            clearInterval(pollingInterval);
                            alert('✅ Pembayaran Berhasil Diterima!');
                            closeModal();
                            window.location.reload();
                        }
                    } catch (error) { console.error(error); }
                }, 3000);
            };

            const showModal = (modal) => { modal.classList.remove('hidden'); modal.classList.add('flex'); };
            const hideModalEl = (modal) => { modal.classList.add('hidden'); modal.classList.remove('flex'); };

            const closeModal = () => {
                if (pollingInterval) clearInterval(pollingInterval);
                hideModalEl(qrisModal);
                hideModalEl(verificationModal);
            };

            const showQrisModal = (data) => {
                document.getElementById('modalTopUpId').textContent = data.topUpId;
                document.getElementById('modalFinalAmount').textContent = formatCurrency(data.finalAmount);
                
                const qr = qrcode(0, 'M');
                qr.addData(data.qrisString);
                qr.make();
                document.getElementById('qrcode-container').innerHTML = qr.createImgTag(6, 0); // Cell size 6, margin 0
                
                // Perbaiki tampilan gambar QR agar pas di container
                const img = document.querySelector('#qrcode-container img');
                if(img) { img.style.display = 'block'; img.style.maxWidth = '100%'; img.style.height = 'auto'; }

                showModal(qrisModal);
                startPolling(data.topUpId);
            };

            // Submit Topup
            topUpForm.addEventListener('submit', async function(event) {
                event.preventDefault();
                const amount = this.elements.amount.value;
                const btn = this.querySelector('button[type="submit"]');
                
                if(amount < 10000 || amount > 950000) return alert('Minimal Rp 10.000 dan Maksimal 950000');

                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...';

                try {
                    const response = await fetch('/api/payment/generate-qris', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ baseAmount: amount })
                    });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.message);
                    
                    await fetchPendingDeposits();
                    showQrisModal(data);
                } catch (error) {
                    alert(error.message);
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-qrcode"></i> Buat Pembayaran QRIS';
                    this.reset();
                }
            });

            // Klik Tombol Lihat
            tableBody.addEventListener('click', async (event) => {
                const btn = event.target.closest('.btn-view');
                if (btn) {
                    const topUpId = btn.dataset.id;
                    btn.disabled = true;
                    try {
                        const response = await fetch(`/api/deposit/details/${topUpId}`);
                        const data = await response.json();
                        if (!response.ok) throw new Error(data.message);
                        showQrisModal(data);
                    } catch (error) {
                        alert(error.message);
                    } finally {
                        btn.disabled = false;
                    }
                }
            });
            
            // Modal Actions
            closeModalBtn.addEventListener('click', closeModal);
            cancelPaymentBtn.addEventListener('click', () => {
                hideModalEl(qrisModal);
                showModal(verificationModal);
            });
            declineCancelBtn.addEventListener('click', () => {
                hideModalEl(verificationModal);
                showModal(qrisModal);
            });
            
            confirmCancelBtn.addEventListener('click', async () => {
                const topUpId = document.getElementById('modalTopUpId').textContent;
                confirmCancelBtn.disabled = true;
                try {
                    await fetch(`/api/deposit/cancel/${topUpId}`, { method: 'POST' });
                    alert('Dibatalkan.');
                    closeModal();
                    fetchPendingDeposits();
                } catch (e) { alert('Gagal.'); }
                finally { confirmCancelBtn.disabled = false; }
            });

            window.addEventListener('click', (e) => {
                if (e.target == qrisModal || e.target == verificationModal) closeModal();
            });

            fetchPendingDeposits();
        });
    </script>
    
    <script src="/js/sidebar.js"></script>
    <script src="/js/theme.js"></script>
    <script src="/js/submenu.js"></script>
</body>
</html>
