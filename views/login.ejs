<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - WUZZSTORE</title>
    
    <link rel="stylesheet" href="/css/tailwind.css">
</head>
<body class="bg-slate-900 text-white overflow-hidden flex justify-center items-center min-h-screen font-sans" style="background: radial-gradient(ellipse at center, #1e293b 0%, #0f172a 100%);">
    <div class="stars-bg">
        <div class="stars"></div>
        <div class="stars"></div>
        <div class="stars"></div>
    </div>

    <div class="bg-slate-800/70 backdrop-blur-xl p-10 rounded-3xl shadow-2xl border border-white/10 w-full max-w-sm text-center hover:-translate-y-1 transition">
        <h1 class="text-4xl font-extrabold tracking-tight bg-gradient-to-br from-white to-indigo-300 bg-clip-text text-transparent mb-6">WUZZSTORE</h1>
        
        <form action="/api/login" method="POST">
            <div class="mb-5">
                <label for="username" class="text-slate-300 text-sm font-semibold text-left block mb-2">Username</label>
                <input type="text" id="username" name="username" class="w-full px-4 py-3 bg-slate-900/60 border border-white/10 rounded-xl text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/25 outline-none" required>
            </div>
            <div class="mb-5">
                <label for="password" class="text-slate-300 text-sm font-semibold text-left block mb-2">Password</label>
                <input type="password" id="password" name="password" class="w-full px-4 py-3 bg-slate-900/60 border border-white/10 rounded-xl text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/25 outline-none" required>
            </div>
            
            <div class="text-right mb-4 text-sm">
                <a href="/forgot-password" class="text-indigo-400 hover:text-white hover:underline transition">Lupa password?</a>
            </div>
            
            <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold shadow-lg shadow-indigo-500/30 hover:-translate-y-0.5 hover:shadow-indigo-500/40 transition">Login</button>
        </form>
        
        <p class="mt-4 text-sm text-slate-400">
            Belum punya akun? <a href="/register" class="text-indigo-400 font-bold hover:text-white hover:underline transition">Register di sini</a>
        </p>
    </div>
</body>
</html>
