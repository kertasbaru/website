<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Riwayat - WUZZSTORE</title>
    
    <link rel="stylesheet" href="/css/tailwind.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/qrcode-generator/qrcode.js"></script>
</head>
<body class="bg-gray-100 dark:bg-slate-900 text-gray-800 dark:text-gray-100 min-h-screen flex flex-col overflow-x-hidden font-sans transition-colors duration-300">

    <%- include('partials/sidebar', { user: user }) %>
    <%- include('partials/header', { user: user }) %>

    <main class="p-6 w-full max-w-7xl mx-auto transition-all lg:ml-[260px] lg:w-[calc(100%-260px)] lg:p-10">
        
        <div class="history-item border border-gray-200 dark:border-slate-700 rounded-2xl bg-white dark:bg-slate-800 mt-5 overflow-hidden transition-all" id="topup-history-item">
            <div class="history-header p-5 font-semibold flex justify-between items-center gap-2.5 text-gray-800 dark:text-gray-100 cursor-pointer select-none hover:bg-black/[0.02] dark:hover:bg-white/[0.03] transition">
                <span><i class="fas fa-wallet"></i> Riwayat Top Up</span>
                <i class="fas fa-chevron-right icon transition-transform duration-500"></i>
            </div>
            <div class="history-details block max-h-0 opacity-0 overflow-hidden px-5 border-t border-transparent transition-all duration-500">
                <div class="flex items-center gap-2.5 mb-5 mt-5">
                    <div class="flex-1">
                        <input type="text" id="topupSearchInput" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" placeholder="Cari ID atau Nominal...">
                    </div>
                    <button id="topupSearchBtn" class="inline-flex items-center justify-center w-8 h-8 p-0 rounded-full bg-blue-500 text-white shadow-none border-none cursor-pointer"><i class="fas fa-search"></i></button>
                    <button id="topupDateFilterBtn" class="inline-block px-4 py-2 text-sm font-semibold rounded-lg text-white bg-blue-500 hover:opacity-90 transition border-none cursor-pointer"><i class="fas fa-calendar-alt"></i></button>
                </div>
                <div class="w-full overflow-x-auto border border-gray-200 dark:border-slate-700 rounded-xl">
                    <table class="w-full border-collapse text-[0.95rem]">
                        <thead>
                            <tr>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">ID</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Jumlah</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Status</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Waktu</th>
                            </tr>
                        </thead>
                        <tbody id="topup-history-body"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="history-item border border-gray-200 dark:border-slate-700 rounded-2xl bg-white dark:bg-slate-800 mt-5 overflow-hidden transition-all" id="transaction-history-item">
            <div class="history-header p-5 font-semibold flex justify-between items-center gap-2.5 text-gray-800 dark:text-gray-100 cursor-pointer select-none hover:bg-black/[0.02] dark:hover:bg-white/[0.03] transition">
                <span><i class="fas fa-shopping-cart"></i> Riwayat Transaksi</span>
                <i class="fas fa-chevron-right icon transition-transform duration-500"></i>
            </div>
            <div class="history-details block max-h-0 opacity-0 overflow-hidden px-5 border-t border-transparent transition-all duration-500">
                 <div class="flex items-center gap-2.5 mb-5 mt-5">
                    <div class="flex-1">
                        <input type="text" id="txSearchInput" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition" placeholder="Cari Produk/Tujuan...">
                    </div>
                    <button id="txSearchBtn" class="inline-flex items-center justify-center w-8 h-8 p-0 rounded-full bg-blue-500 text-white shadow-none border-none cursor-pointer"><i class="fas fa-search"></i></button>
                    <button id="txDateFilterBtn" class="inline-block px-4 py-2 text-sm font-semibold rounded-lg text-white bg-blue-500 hover:opacity-90 transition border-none cursor-pointer"><i class="fas fa-calendar-alt"></i></button>
                </div>
                <div class="w-full overflow-x-auto border border-gray-200 dark:border-slate-700 rounded-xl">
                    <table class="w-full border-collapse text-[0.95rem]">
                        <thead>
                            <tr>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Ref ID</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Produk</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Tujuan</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Harga</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Status</th>
                                <th class="bg-gray-50 dark:bg-slate-900 text-gray-500 dark:text-slate-400 font-semibold p-4 uppercase text-xs tracking-wider border-b border-gray-200 dark:border-slate-700 text-center">Ket</th>
                            </tr>
                        </thead>
                        <tbody id="transaction-history-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <div id="historyQrisModal" class="hidden fixed inset-0 z-[3000] overflow-auto bg-black/50 backdrop-blur-sm pt-[60px]">
        <div class="bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-100 mx-auto p-8 w-[90%] max-w-md rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 relative animate-slideDown mt-[5%]">
             <span class="modal-close-btn absolute top-5 right-5 text-gray-400 dark:text-slate-500 text-2xl cursor-pointer hover:text-red-500 transition" id="closeHistoryQrisBtn">&times;</span>
            <h3 class="mb-5 text-gray-800 dark:text-gray-100 font-bold tracking-tight text-xl">Scan Pembayaran</h3>
            <div class="flex justify-center">
                <div id="historyQrisContainer" class="p-4 bg-white rounded-xl border border-gray-200"></div>
            </div>
        </div>
    </div>

    <div id="dateFilterModal" class="hidden fixed inset-0 z-[3000] overflow-auto bg-black/50 backdrop-blur-sm pt-[60px]">
        <div class="bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-100 mx-auto p-8 w-[90%] max-w-md rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 relative animate-slideDown mt-[5%]">
            <h4 class="mb-5 text-gray-800 dark:text-gray-100 font-bold tracking-tight text-lg">Filter Tanggal</h4>
            <div class="mb-5 text-left">
                <label for="startDate" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Dari Tanggal</label>
                <input type="date" id="startDate" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition">
            </div>
            <div class="mb-5 text-left">
                <label for="endDate" class="block mb-2 font-semibold text-sm text-gray-800 dark:text-slate-400">Sampai Tanggal</label>
                <input type="date" id="endDate" class="w-full px-4 py-3 border border-gray-200 dark:border-slate-700 rounded-xl text-[0.95rem] bg-white dark:bg-slate-900 text-gray-800 dark:text-gray-100 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 outline-none transition">
            </div>
            <div class="flex gap-4 mt-6">
                <button type="button" id="closeDateModalBtn" class="w-full py-3.5 rounded-xl bg-gray-400 text-white font-semibold shadow-lg hover:-translate-y-0.5 transition border-none cursor-pointer">Batal</button>
                <button type="button" id="applyDateFilterBtn" class="w-full py-3.5 rounded-xl bg-emerald-500 text-white font-semibold shadow-lg shadow-emerald-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer">Terapkan</button>
            </div>
        </div>
    </div>

    <div id="txDetailHistoryModal" class="hidden fixed inset-0 z-[3000] overflow-auto bg-black/50 backdrop-blur-sm pt-[60px]">
        <div class="bg-white dark:bg-slate-800 text-gray-800 dark:text-gray-100 mx-auto p-8 w-[90%] max-w-md rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700 relative animate-slideDown mt-[5%]">
            
            <div class="text-center mb-5">
                <div id="detailStatusIcon" class="text-[3.5rem] mb-2.5"></div>
                <h3 class="m-0 font-bold text-xl text-gray-800 dark:text-gray-100">Detail Transaksi</h3>
                <p id="detailRefIdHeader" class="text-gray-500 dark:text-slate-400 text-sm mt-1.5 font-mono"></p>
            </div>

            <hr class="border-0 border-b-2 border-dashed border-gray-200 dark:border-slate-700 mb-5">

            <ul class="list-none p-0 m-0">
                <li class="flex justify-between items-center py-3 border-b border-dashed border-gray-200 dark:border-slate-700 text-[0.95rem]">
                    <dt class="text-gray-500 dark:text-slate-400 font-medium">Nama Produk</dt>
                    <dd id="detailProductName" class="font-semibold text-gray-800 dark:text-gray-100 text-right"></dd>
                </li>
                <li class="flex justify-between items-center py-3 border-b border-dashed border-gray-200 dark:border-slate-700 text-[0.95rem]">
                    <dt class="text-gray-500 dark:text-slate-400 font-medium">Nomor Tujuan</dt>
                    <dd id="detailDestination" class="font-semibold text-gray-800 dark:text-gray-100 text-right"></dd>
                </li>
                <li class="flex justify-between items-center py-3 border-b border-dashed border-gray-200 dark:border-slate-700 text-[0.95rem]">
                    <dt class="text-gray-500 dark:text-slate-400 font-medium">Harga</dt>
                    <dd id="detailPrice" class="font-semibold text-indigo-500 text-right"></dd>
                </li>
                <li class="flex justify-between items-center py-3 border-b border-dashed border-gray-200 dark:border-slate-700 text-[0.95rem]">
                    <dt class="text-gray-500 dark:text-slate-400 font-medium">Metode Pembayaran</dt>
                    <dd id="detailPayment" class="font-semibold text-gray-800 dark:text-gray-100 text-right"></dd>
                </li>
                <li class="flex justify-between items-center py-3 border-b border-dashed border-gray-200 dark:border-slate-700 text-[0.95rem]">
                    <dt class="text-gray-500 dark:text-slate-400 font-medium">Status</dt>
                    <dd id="detailStatus" class="font-semibold text-gray-800 dark:text-gray-100 text-right"></dd>
                </li>
                <li class="flex justify-between items-center py-3 border-b border-dashed border-gray-200 dark:border-slate-700 text-[0.95rem]">
                    <dt class="text-gray-500 dark:text-slate-400 font-medium">SN / Keterangan</dt>
                    <dd id="detailPengelola" class="font-semibold text-gray-800 dark:text-gray-100 text-right max-w-[60%] break-words text-[0.85rem]"></dd>
                </li>
                <li class="flex justify-between items-center py-3 border-b-0 text-[0.95rem]">
                    <dt class="text-gray-500 dark:text-slate-400 font-medium">Waktu</dt>
                    <dd id="detailWaktu" class="font-semibold text-gray-800 dark:text-gray-100 text-right text-[0.85rem]"></dd>
                </li>
            </ul>

            <div class="flex gap-4 mt-6">
                <button id="copyTxDetailBtn" class="w-full py-3.5 rounded-xl bg-blue-500 text-white font-semibold shadow-lg shadow-blue-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer">
                    <i class="fas fa-copy"></i> Salin
                </button>
                <button id="closeTxDetailHistoryBtn" class="w-full py-3.5 rounded-xl bg-red-500 text-white font-semibold shadow-lg shadow-red-500/30 hover:-translate-y-0.5 transition border-none cursor-pointer">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // --- Inisialisasi Elemen DOM ---
            const topupHistoryBody = document.getElementById('topup-history-body');
            const transactionHistoryBody = document.getElementById('transaction-history-body');
            const historyItems = document.querySelectorAll('.history-item');
            
            const historyQrisModal = document.getElementById('historyQrisModal');
            const historyQrisContainer = document.getElementById('historyQrisContainer');
            const dateFilterModal = document.getElementById('dateFilterModal');
            const txDetailHistoryModal = document.getElementById('txDetailHistoryModal');

            const topupSearchInput = document.getElementById('topupSearchInput');
            const txSearchInput = document.getElementById('txSearchInput');
            const startDateInput = document.getElementById('startDate');
            const endDateInput = document.getElementById('endDate');
            
            const topupSearchBtn = document.getElementById('topupSearchBtn');
            const txSearchBtn = document.getElementById('txSearchBtn');
            const topupDateFilterBtn = document.getElementById('topupDateFilterBtn');
            const txDateFilterBtn = document.getElementById('txDateFilterBtn');
            const closeDateModalBtn = document.getElementById('closeDateModalBtn');
            const applyDateFilterBtn = document.getElementById('applyDateFilterBtn');
            
            const copyTxDetailBtn = document.getElementById('copyTxDetailBtn');
            const closeTxDetailHistoryBtn = document.getElementById('closeTxDetailHistoryBtn');
            const closeHistoryQrisBtn = document.getElementById('closeHistoryQrisBtn');

            let currentFilterType = '';

            // --- Modal Helpers ---
            const showModal = (modal) => { modal.classList.remove('hidden'); modal.classList.add('flex'); };
            const hideModal = (modal) => { modal.classList.add('hidden'); modal.classList.remove('flex'); };

            // --- Helper Functions ---
            const formatCurrency = (amount) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(amount);

            const formatWaktu = (dateString) => {
                if (!dateString) return '-';
                const d = new Date(dateString);
                if (isNaN(d)) return '-';
                const pad = (num) => num.toString().padStart(2, '0');
                return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear().toString().slice(-2)}, ${pad(d.getHours())}:${pad(d.getMinutes())}`;
            };

            const maskString = (str) => {
                if (!str || str.length <= 4) return str;
                return '*'.repeat(str.length - 4) + str.slice(-4);
            };

            const getStatusBadge = (status) => {
                status = status ? status.toLowerCase() : 'failed';
                let badgeClasses = 'bg-red-100 text-red-600';
                if (status === 'success' || status === 'sukses') badgeClasses = 'bg-emerald-100 text-emerald-600';
                else if (['pending', 'processing'].includes(status)) badgeClasses = 'bg-amber-100 text-amber-600';
                return `<span class="px-3 py-1.5 rounded-full font-bold text-xs uppercase tracking-wide ${badgeClasses}">${status.toUpperCase()}</span>`;
            };

            // --- LOGIKA ACCORDION (BUKA-TUTUP) YANG BENAR ---
            historyItems.forEach(item => {
                const header = item.querySelector('.history-header');
                header.addEventListener('click', () => {
                    // 1. Cek apakah item ini sedang aktif
                    const isActive = item.classList.contains('active');
                    
                    // 2. Tutup SEMUA item dulu (agar cuma 1 yang terbuka)
                    historyItems.forEach(otherItem => otherItem.classList.remove('active'));
                    
                    // 3. Jika tadi TIDAK aktif, maka sekarang aktifkan (Buka).
                    //    Jika tadi SUDAH aktif, biarkan tertutup (Toggle Close).
                    if (!isActive) {
                        item.classList.add('active');
                    }
                });
            });

            // --- KLIK DETAIL TRANSAKSI ---
            transactionHistoryBody.addEventListener('click', (e) => {
                // Cek jika tombol view/qris diklik
                if (e.target.closest('.btn-view') || e.target.classList.contains('show-history-qris')) {
                    const btn = e.target.closest('.show-history-qris');
                    if(btn) {
                        const qris = btn.getAttribute('data-qris');
                        if (qris) showHistoryQrisModal(qris);
                    }
                    return; 
                }

                const row = e.target.closest('tr');
                if (!row || !row.dataset.transaction) return;

                const txData = JSON.parse(row.dataset.transaction);
                const status = txData.status ? txData.status.toLowerCase() : 'failed';
                
                let pengelolaText = (status === 'success' || status === 'sukses') 
                    ? (txData.serial_number.slice(-4) || '-') 
                    : (txData.message || '-');

                // Set Icon
                const iconContainer = document.getElementById('detailStatusIcon');
                if (status === 'success' || status === 'sukses') {
                    iconContainer.innerHTML = '<i class="fas fa-check-circle" style="color: #10b981;"></i>';
                } else if (['pending', 'processing'].includes(status)) {
                    iconContainer.innerHTML = '<i class="fas fa-clock" style="color: #f59e0b;"></i>';
                } else {
                    iconContainer.innerHTML = '<i class="fas fa-times-circle" style="color: #ef4444;"></i>';
                }

                // Set Text Content
                document.getElementById('detailRefIdHeader').textContent = `#${txData.ref_id}`;
                document.getElementById('detailProductName').textContent = txData.product_name || '-';
                document.getElementById('detailDestination').textContent = txData.destination || '-';
                document.getElementById('detailPrice').textContent = formatCurrency(txData.price);
                document.getElementById('detailPayment').textContent = txData.payment_method || '-';
                document.getElementById('detailStatus').innerHTML = getStatusBadge(txData.status);
                document.getElementById('detailPengelola').textContent = pengelolaText;
                document.getElementById('detailWaktu').textContent = formatWaktu(txData.updated_at);

                txDetailHistoryModal.classList.remove('hidden');
                txDetailHistoryModal.classList.add('flex');
            });
            
            // --- FUNGSI COPY ---
            const copyToClipboard = (text) => {
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text).then(() => alert('Tersalin!')).catch(() => fallbackCopy(text));
                } else {
                    fallbackCopy(text);
                }
            };

            const fallbackCopy = (text) => {
                const ta = document.createElement("textarea");
                ta.value = text;
                ta.style.position = "fixed";
                document.body.appendChild(ta);
                ta.focus(); ta.select();
                try { document.execCommand('copy'); alert('Tersalin!'); } catch (err) { alert('Gagal salin manual.'); }
                document.body.removeChild(ta);
            };

            copyTxDetailBtn.addEventListener('click', () => {
                const ref = document.getElementById('detailRefIdHeader').textContent;
                const prod = document.getElementById('detailProductName').textContent;
                const dest = document.getElementById('detailDestination').textContent;
                const price = document.getElementById('detailPrice').textContent;
                const stat = document.getElementById('detailStatus').innerText;
                const sn = document.getElementById('detailPengelola').textContent;
                
                const text = `STRUK TRANSAKSI

ID     : ${ref}
Produk : ${prod}
Tujuan : ${dest}
Harga  : ${price}
Status : ${stat}
SN/Ket : ${sn}

Terima Kasih!`;
                copyToClipboard(text);
            });

            // --- FETCH DATA ---
            const fetchHistory = async (type, searchTerm = '', startDate = '', endDate = '') => {
                const endpoint = type === 'topup' ? '/api/history/topups' : '/api/history/transactions';
                const bodyElement = type === 'topup' ? topupHistoryBody : transactionHistoryBody;
                const colSpan = type === 'topup' ? 4 : 6; 
                
                bodyElement.innerHTML = `<tr><td colspan="${colSpan}" class="p-4 border-b border-gray-200 dark:border-slate-700 text-center"><div class="spinner mx-auto w-[25px] h-[25px]"></div></td></tr>`;
                
                try {
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ searchTerm, startDate, endDate })
                    });
                    const result = await response.json();
                    if (!response.ok || !result.success) throw new Error(result.message);
                    
                    if (type === 'topup') populateTopupHistory(result.data);
                    else populateTransactionHistory(result.data);
                    
                } catch (error) {
                    bodyElement.innerHTML = `<tr><td colspan="${colSpan}" class="p-4 text-center text-red-500">Gagal memuat data.</td></tr>`;
                }
            };

            const populateTopupHistory = (topups) => {
                topupHistoryBody.innerHTML = '';
                if (topups.length === 0) {
                    topupHistoryBody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-gray-500 dark:text-slate-400">Belum ada riwayat.</td></tr>';
                    return;
                }
                topups.forEach(topup => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-gray-800 dark:text-gray-100 align-middle"><small>${topup.top_up_id}</small></td>
                        <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-gray-800 dark:text-gray-100 align-middle">${formatCurrency(topup.amount)}</td>
                        <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-center align-middle">${getStatusBadge(topup.status)}</td>
                        <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-gray-800 dark:text-gray-100 align-middle"><small>${formatWaktu(topup.updated_at)}</small></td>
                    `;
                    topupHistoryBody.appendChild(row);
                });
            };

            const populateTransactionHistory = (transactions) => {
                transactionHistoryBody.innerHTML = '';
                if (transactions.length === 0) {
                    transactionHistoryBody.innerHTML = '<tr><td colspan="6" class="p-4 text-center text-gray-500 dark:text-slate-400">Belum ada transaksi.</td></tr>';
                    return;
                }
                transactions.forEach(tx => {
                    const row = document.createElement('tr');
                    row.classList.add('cursor-pointer', 'hover:bg-gray-100', 'dark:hover:bg-white/[0.03]', 'transition');
                    row.dataset.transaction = JSON.stringify(tx);
                    
                    let snText = (['success', 'sukses'].includes((tx.status||'').toLowerCase())) 
                        ? tx.serial_number.slice(-4) || '' 
                        : (tx.message || '-');

                    row.innerHTML = `
                        <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-gray-800 dark:text-gray-100 align-middle"><small>${tx.ref_id}</small></td>
                        <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-gray-800 dark:text-gray-100 align-middle">${tx.product_name || '-'}</td>
                        <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-gray-800 dark:text-gray-100 align-middle">${tx.destination}</td>
                        <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-red-500 align-middle">${formatCurrency(tx.price)}</td>
                        <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-center align-middle">${getStatusBadge(tx.status)}</td>
                        <td class="p-4 border-b border-gray-200 dark:border-slate-700 text-gray-800 dark:text-gray-100 align-middle"><small>${snText}</small></td>
                    `;
                    transactionHistoryBody.appendChild(row);
                });
            };

            // --- Show QRIS Modal ---
            const showHistoryQrisModal = (qrisString) => {
                historyQrisContainer.innerHTML = '';
                if (qrisString.startsWith('data:image')) {
                    const img = document.createElement('img');
                    img.src = qrisString;
                    img.style.maxWidth = '250px';
                    historyQrisContainer.appendChild(img);
                } else {
                    const qr = qrcode(0, 'M'); qr.addData(qrisString); qr.make();
                    historyQrisContainer.innerHTML = qr.createImgTag(6, 0);
                }
                historyQrisModal.classList.remove('hidden');
                historyQrisModal.classList.add('flex');
            };

            // --- Event Listeners Search/Filter ---
            topupSearchBtn.addEventListener('click', () => fetchHistory('topup', topupSearchInput.value));
            txSearchBtn.addEventListener('click', () => fetchHistory('transaction', txSearchInput.value));
            
            topupDateFilterBtn.addEventListener('click', () => { currentFilterType = 'topup'; showModal(dateFilterModal); });
            txDateFilterBtn.addEventListener('click', () => { currentFilterType = 'transaction'; showModal(dateFilterModal); });
            closeDateModalBtn.addEventListener('click', () => hideModal(dateFilterModal));
            
            applyDateFilterBtn.addEventListener('click', () => {
                const start = startDateInput.value; const end = endDateInput.value;
                if (!start || !end) return alert('Pilih tanggal.');
                const endD = new Date(end); endD.setHours(23, 59, 59, 999);
                fetchHistory(currentFilterType, currentFilterType==='topup'?topupSearchInput.value:txSearchInput.value, new Date(start).toISOString(), endD.toISOString());
                hideModal(dateFilterModal);
            });

            // --- Tutup Modal ---
            const hideModals = () => {
                hideModal(dateFilterModal);
                hideModal(txDetailHistoryModal);
                hideModal(historyQrisModal);
            };
            
            closeTxDetailHistoryBtn.addEventListener('click', hideModals);
            closeHistoryQrisBtn.addEventListener('click', () => hideModal(historyQrisModal));
            window.addEventListener('click', (e) => {
                if([dateFilterModal, txDetailHistoryModal, historyQrisModal].includes(e.target)) hideModals();
            });

            // Load Data Awal
            const today = new Date();
            const startOfDay = new Date(today.getFullYear(), today.getMonth(), today.getDate()).toISOString();
            const endOfDay = new Date(today.getFullYear(), today.getMonth(), today.getDate(), 23, 59, 59).toISOString();
            fetchHistory('topup', '', startOfDay, endOfDay);
            fetchHistory('transaction', '', startOfDay, endOfDay);
        });
    </script>
    
    <script src="/js/sidebar.js"></script>
    <script src="/js/theme.js"></script>
    <script src="/js/submenu.js"></script>
</body>
</html>
