<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verifikasi OTP - WUZZSTORE</title>
    
    <link rel="stylesheet" href="/css/tailwind.css">
</head>
<body class="bg-slate-900 text-white overflow-hidden flex justify-center items-center min-h-screen font-sans" style="background: radial-gradient(ellipse at center, #1e293b 0%, #0f172a 100%);">
    <div class="stars-bg">
        <div class="stars"></div>
        <div class="stars"></div>
        <div class="stars"></div>
    </div>

    <div class="bg-slate-800/70 backdrop-blur-xl p-10 rounded-3xl shadow-2xl border border-white/10 w-full max-w-sm text-center hover:-translate-y-1 transition">
        <h1 class="text-4xl font-extrabold tracking-tight bg-gradient-to-br from-white to-indigo-300 bg-clip-text text-transparent mb-4">WUZZSTORE</h1>
        <h3 class="text-lg font-semibold mb-2">Verifikasi Email Anda</h3>
        
        <p class="text-sm mb-5 leading-relaxed text-slate-300">
            Kami telah mengirimkan kode OTP ke email <br>
            <span class="bg-indigo-500/20 px-2 py-0.5 rounded text-indigo-300 font-bold">
                <%= email %>
            </span><br>
            Silakan cek kotak masuk atau folder spam Anda.
        </p>

        <div id="message-display" class="text-center font-bold mb-4"></div>

        <form id="otpForm">
            <div class="mb-5">
                <label for="otp" class="text-slate-300 text-sm font-semibold text-left block mb-2">Kode OTP (6 Digit)</label>
                <input type="text" id="otp" name="otp" class="w-full px-4 py-3 bg-slate-900/60 border border-white/10 rounded-xl text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/25 outline-none text-center tracking-widest text-lg" 
                       placeholder="Contoh: 123456" required 
                       maxlength="6" pattern="\d{6}">
            </div>
            <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold shadow-lg shadow-indigo-500/30 hover:-translate-y-0.5 hover:shadow-indigo-500/40 transition">Verifikasi</button>
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const otpForm = document.getElementById('otpForm');
            const messageDisplay = document.getElementById('message-display');
            const submitButton = otpForm.querySelector('button');
            const otpInput = document.getElementById('otp');

            // Auto-focus ke input OTP
            otpInput.focus();

            // Hanya izinkan angka
            otpInput.addEventListener('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '');
            });

            otpForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const otp = otpInput.value;

                submitButton.disabled = true;
                submitButton.textContent = 'Memverifikasi...';
                messageDisplay.textContent = '';
                messageDisplay.style.color = '';

                try {
                    const response = await fetch('/api/auth/complete-registration', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ otp })
                    });
                    const result = await response.json();

                    if (!response.ok) {
                        throw new Error(result.message || 'Terjadi kesalahan.');
                    }

                    // Sukses
                    messageDisplay.style.color = '#5cb85c';
                    messageDisplay.textContent = result.message;
                    submitButton.style.display = 'none'; // Sembunyikan tombol
                    
                    // Redirect ke login setelah 3 detik
                    setTimeout(() => {
                        window.location.href = '/login';
                    }, 3000);

                } catch (error) {
                    // Gagal
                    messageDisplay.style.color = '#d9534f';
                    messageDisplay.textContent = 'Error: ' + error.message;
                    submitButton.disabled = false;
                    submitButton.textContent = 'Verifikasi';
                }
            });
        });
    </script>
</body>
</html>
