<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lupa Password - WUZZSTORE</title>
    
    <link rel="stylesheet" href="/css/tailwind.css">
</head>
<body class="bg-slate-900 text-white overflow-hidden flex justify-center items-center min-h-screen font-sans" style="background: radial-gradient(ellipse at center, #1e293b 0%, #0f172a 100%);">
    <div class="stars-bg">
        <div class="stars"></div>
        <div class="stars"></div>
        <div class="stars"></div>
    </div>

    <div class="bg-slate-800/70 backdrop-blur-xl p-10 rounded-3xl shadow-2xl border border-white/10 w-full max-w-sm text-center hover:-translate-y-1 transition">
        <h1 class="text-4xl font-extrabold tracking-tight bg-gradient-to-br from-white to-indigo-300 bg-clip-text text-transparent mb-4">WUZZSTORE</h1>
        <h3 class="text-lg font-semibold mb-2">Lupa Password</h3>
        <p class="text-sm mb-5 text-slate-400">
            Masukkan alamat email Anda yang terdaftar. Kami akan mengirimkan link untuk mereset password Anda.
        </p>

        <div id="message-display" class="text-center font-bold mb-4"></div>

        <form id="forgotPasswordForm">
            <div class="mb-5">
                <label for="email" class="text-slate-300 text-sm font-semibold text-left block mb-2">Email</label>
                <input type="email" id="email" name="email" class="w-full px-4 py-3 bg-slate-900/60 border border-white/10 rounded-xl text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/25 outline-none" placeholder="email@contoh.com" required>
            </div>
            <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold shadow-lg shadow-indigo-500/30 hover:-translate-y-0.5 hover:shadow-indigo-500/40 transition">Kirim Link Reset</button>
        </form>
        
        <p class="mt-4 text-sm text-slate-400">
            Ingat password Anda? <a href="/login" class="text-indigo-400 font-bold hover:text-white hover:underline transition">Login di sini</a>
        </p>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const forgotPasswordForm = document.getElementById('forgotPasswordForm');
            const messageDisplay = document.getElementById('message-display');
            const submitButton = forgotPasswordForm.querySelector('button');

            forgotPasswordForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = document.getElementById('email').value;

                // Ubah status tombol saat loading
                submitButton.disabled = true;
                submitButton.textContent = 'Mengirim...';
                messageDisplay.textContent = '';
                messageDisplay.style.color = '';

                try {
                    // Kirim permintaan ke API Backend
                    const response = await fetch('/api/auth/forgot-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email })
                    });
                    const result = await response.json();

                    if (!response.ok) {
                        throw new Error(result.message || 'Terjadi kesalahan.');
                    }
                    
                    // Tampilkan pesan sukses
                    messageDisplay.style.color = '#5cb85c';
                    messageDisplay.textContent = result.message;
                    submitButton.style.display = 'none'; // Sembunyikan tombol agar tidak diklik lagi

                } catch (error) {
                    // Tampilkan pesan error
                    messageDisplay.style.color = '#d9534f';
                    messageDisplay.textContent = 'Error: ' + error.message;
                    submitButton.disabled = false;
                    submitButton.textContent = 'Kirim Link Reset';
                }
            });
        });
    </script>
</body>
</html>
